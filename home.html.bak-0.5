<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
<title>Home</title>
<script src="icons.js"></script>
<style>
:root{--bg:#fff;--text:#16181e;--dim:#6b7080;--soft:#f1f2f5;--soft2:#e6e8ec;--acc:#ffd23f;--onacc:#16181e;--accsoft:#fff6d9;--acctext:#94790f}
*{box-sizing:border-box;margin:0;-webkit-tap-highlight-color:transparent}
html,body{background:var(--bg);color:var(--text);font:16px/1.4 system-ui,-apple-system,Roboto,sans-serif}
body{min-height:100vh;padding:0 18px 48px}
a{color:inherit;text-decoration:none}
main{max-width:560px;margin:0 auto}
.top{padding-top:9vh;display:flex;flex-direction:column;align-items:center;text-align:center}
.mark{width:58px;height:58px;border-radius:19px;background:var(--acc);color:var(--onacc);display:grid;place-items:center;animation:pop .5s cubic-bezier(.2,1.4,.4,1) both}
.mark svg{width:46px;height:46px}
.hello{margin-top:18px;font-size:27px;font-weight:700;letter-spacing:-.02em;animation:up .45s .05s ease both}
.date{margin-top:4px;color:var(--dim);font-size:14px;animation:up .45s .1s ease both}
.search{margin-top:26px;height:60px;border-radius:30px;background:var(--soft);display:flex;align-items:center;gap:14px;padding:0 10px 0 22px;color:var(--dim);font-size:17px;transition:transform .12s,background .12s;animation:up .45s .15s ease both}
.search:active{transform:scale(.98);background:var(--soft2)}
.search>svg{width:22px;height:22px;flex:none;color:var(--text)}
.search span{flex:1}
.at{width:42px;height:42px;border-radius:21px;background:var(--acc);color:var(--onacc);display:grid;place-items:center;font-weight:700;font-size:19px;flex:none}
h2{margin:34px 4px 14px;font-size:13px;font-weight:600;color:var(--dim);letter-spacing:.02em}
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px 6px;animation:up .45s .2s ease both}
.tile{display:flex;flex-direction:column;align-items:center;gap:8px;min-width:0}
.tile:active .ic{transform:scale(.9)}
.ic{width:58px;height:58px;border-radius:19px;background:var(--soft);display:grid;place-items:center;transition:transform .12s;font-weight:700;font-size:21px;text-transform:uppercase;overflow:hidden;position:relative}
.ic img{width:28px;height:28px;border-radius:6px;position:absolute}
.app .ic{background:var(--accsoft);color:var(--acctext)}
.ic svg{width:25px;height:25px}
.tile span{font-size:12.5px;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
svg{fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
@keyframes up{from{opacity:0;transform:translateY(10px)}}
@keyframes pop{from{opacity:0;transform:scale(.6)}}
</style>
</head>
<body>
<main>
  <div class="top">
    <div class="mark"><svg viewBox="4 0 61 61"><path fill="#16181e" stroke="none" d="M12 47.5C8 43 6.5 37 7 31 8 17.5 19.5 8 34 8c13 0 22.5 7.5 25 18l1.6 10c1.8 2.6 2.4 5 2 8-.8 5.5-5 9-10.6 9H31c-7.5 0-14.5-1.5-19-5.5Z"/><path style="fill:var(--acc)" stroke="none" d="M34 28C22 29.2 13 35.5 9 44.4 15 39.1 23 34.5 34 33.2Z"/><rect style="fill:var(--acc)" stroke="none" x="28" y="20.5" width="34.5" height="13" rx="6.5"/><circle cx="36" cy="27" r="3.8" fill="none" stroke="#16181e" stroke-width="2.5"/><path d="m38.8 29.8 2.5 2.5" fill="none" stroke="#16181e" stroke-width="2.5" stroke-linecap="round"/></svg></div>
    <p class="hello" id="hello"></p>
    <p class="date" id="date"></p>
  </div>
  <a class="search" href="yukiweb://focus"><svg viewBox="0 0 24 24"><path d="m21 21-4.34-4.34"/><circle cx="11" cy="11" r="8"/></svg><span>Search or type an address</span><b class="at" onclick="event.preventDefault();location.href='yukiweb://at'">@</b></a>
  <h2 id="fh" hidden>Frequent</h2>
  <div class="grid" id="freq"></div>
  <h2>Yuki apps</h2>
  <div class="grid" id="apps"></div>
</main>
<script>
// The app hands over its theme, the most visited sites and your first name in the hash.
let data = {};
try { data = JSON.parse(decodeURIComponent(location.hash.slice(1)) || '{}'); } catch {}
const css = document.documentElement.style;
for (const [k, v] of Object.entries(data.c || {})) css.setProperty('--' + k, v);
css.colorScheme = data.dark ? 'dark' : 'light';

const h = new Date().getHours();
const greet = h < 5 ? 'Good night' : h < 12 ? 'Good morning' : h < 18 ? 'Good afternoon' : 'Good evening';
document.getElementById('hello').textContent = greet + (data.name ? ', ' + data.name : '');
document.getElementById('date').textContent = new Date().toLocaleDateString(undefined, { weekday: 'long', day: 'numeric', month: 'long' });

const esc = s => String(s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
const svg = n => `<svg viewBox="0 0 24 24">${(typeof ICONS !== 'undefined' && ICONS[n]) || ''}</svg>`;
const APPS = [['chat', 'Chat', 'https://yukichat.lol'], ['music', 'Music', 'https://music.yukichat.lol'], ['mail', 'Mail', 'https://mail.yukichat.lol'],
  ['wallet', 'Wallet', 'https://wallet.yukichat.lol'], ['pages', 'Pages', 'https://pages.yukichat.lol'], ['write', 'Write', 'https://write.yukichat.lol'],
  ['board', 'Board', 'https://board.yukichat.lol'], ['html', 'HTML', 'yukiweb://html']];
document.getElementById('apps').innerHTML = APPS.map(([i, n, u]) => `<a class="tile app" href="${u}"><div class="ic">${svg(i)}</div><span>${n}</span></a>`).join('');

const host = u => { try { return new URL(u).hostname.replace(/^www\./, '') } catch { return u } };
const sites = data.top || [];
if (sites.length) {
  document.getElementById('fh').hidden = false;
  document.getElementById('freq').innerHTML = sites.slice(0, 8).map(([t, u]) => {
    const hh = host(u), origin = (() => { try { return new URL(u).origin } catch { return '' } })();
    // The site's own icon covers the letter once it loads.
    return `<a class="tile" href="${esc(u)}"><div class="ic">${esc(hh[0] || '?')}<img src="${esc(origin)}/favicon.ico" alt="" onload="this.parentNode.firstChild.textContent=''" onerror="this.remove()"></div><span>${esc(hh.split('.').slice(-2, -1)[0] || hh)}</span></a>`;
  }).join('');
}
</script>
</body>
</html>
